# Postgres + pgvector (Podman / A1). DBeaver: host/port/db/user/password below
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jena
POSTGRES_USER=jena
POSTGRES_PASSWORD=jena
DATABASE_URL=postgresql://jena:jena@localhost:5432/jena

# Gemini (no billing linked). Embeddings: gemini-embedding-001 @ 768-d
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_VISION_MODEL=gemini-flash-latest
EMBED_DIM=768

# Cloudflare R2 (S3 API)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rag-portfolio
R2_ENDPOINT=https://b994bc9e84ca49df47501ee6d93c6d7c.r2.cloudflarestorage.com
R2_PREFIX_IN_PROGRESS=in-progress
R2_PREFIX_SUCCEEDED=succeeded
R2_PREFIX_FAILED=failed

# Protect ingest APIs: Authorization: Bearer <token>
INGEST_TOKEN=change-me

MAX_FILE_BYTES=10485760
MAX_FILES_PER_REQUEST=10
